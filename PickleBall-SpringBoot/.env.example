# ── Server ──
PORT=8080

# ── Database (MySQL / TiDB Cloud) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=demopick_main
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# ── Security & JWT ──
JWT_SECRET=your_jwt_secret_key_at_least_32_bytes_long_here
JWT_EXPIRATION=86400000

# ── CORS ──
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://demopick-client.vercel.app,https://demopick-admin.vercel.app

# ── MoMo Sandbox ──
MOMO_PARTNER_CODE=MOMOBKUN20180529
MOMO_ACCESS_KEY=your_momo_access_key_here
MOMO_SECRET_KEY=your_momo_secret_key_here
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5173/payment/momo/callback
MOMO_IPN_URL=http://127.0.0.1:8080/api/v1/webhooks/payment/momo

# ── Google OAuth ──
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# ── Mail SMTP (Gmail) ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address_here
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_FROM_ADDRESS=your_gmail_address_here
MAIL_FROM_NAME=Pickleball

# ── GHN Express ──
GHN_API_URL=https://online-gateway.ghn.vn/shiip/public-api/v2
GHN_API_TOKEN=your_ghn_api_token_here
GHN_SHOP_ID=your_ghn_shop_id_here
GHN_SENDER_DISTRICT_ID=1485
GHN_SENDER_WARD_CODE=1A0607

# ── Redis (Tùy chọn) ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
