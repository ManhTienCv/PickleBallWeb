APP_NAME=DemoPick
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (MySQL) ──────────────────────────────
DB_CONNECTION=main
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# Module-specific databases
DB_MAIN_DATABASE=demopick_main
DB_SHOP_DATABASE=demopick_shop
DB_BOOKING_DATABASE=demopick_booking

# ── Redis ─────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Queue & Cache ─────────────────────────────────
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# ── Sanctum ───────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174

# ── CORS ──────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ── Payment (VietQR Ngân Hàng & MoMo) ──────────────
BANK_ID=ICB
BANK_ACCOUNT_NO=102888888888
BANK_ACCOUNT_NAME=NGUYEN MANH TIEN

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api
MOMO_REDIRECT_URL=http://localhost:5173/payment/callback
MOMO_IPN_URL=http://localhost:8000/api/v1/webhooks/payment/momo

# ── Mail ──────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
